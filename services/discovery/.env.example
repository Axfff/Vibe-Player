# Copy to .env in this directory. Values are read on process start.
# Modes: unconfigured | mock | live. Mock catalogs return an explicitly empty demo.
DISCOVERY_VISION_MODE=unconfigured
DISCOVERY_ITUNES_MODE=unconfigured
DISCOVERY_JAMENDO_MODE=unconfigured
# iTunes public search needs no key. Set its mode to live to enable manual discovery.
DISCOVERY_CATALOG_CALL_BUDGET=80
# Project owner's own registered Jamendo client ID only.
DISCOVERY_JAMENDO_CLIENT_ID=
# Set these only after reviewing this project's use, account/territory and attribution.
DISCOVERY_JAMENDO_PREVIEW_ENABLED=false
DISCOVERY_JAMENDO_NONCOMMERCIAL=false
DISCOVERY_JAMENDO_TERMS_ACCEPTED=false
DISCOVERY_JAMENDO_REVIEW_ID=
# Optional OpenAI Responses vision adapter. Explicit provider/model/key/call budget required.
DISCOVERY_VISION_MODEL=
DISCOVERY_VISION_KEY=
DISCOVERY_CLOUD_AUTHORIZED=false
DISCOVERY_VISION_CALL_BUDGET=0
