<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 style="@style/Discovery.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
  <TextView android:id="@+id/discovery_track_title" style="@style/Discovery.Label" android:layout_width="match_parent" android:layout_height="wrap_content"  android:textSize="20sp" android:accessibilityHeading="true"/>
  <TextView android:id="@+id/discovery_track_artist" style="@style/Discovery.Copy" android:layout_width="match_parent" android:layout_height="wrap_content"  android:layout_marginTop="4dp" android:textSize="15sp"/>
  <TextView android:id="@+id/discovery_track_identity" style="@style/Discovery.Copy" android:layout_width="match_parent" android:layout_height="wrap_content"  android:layout_marginTop="10dp" android:textSize="12sp" android:textIsSelectable="true"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
   <com.google.android.material.button.MaterialButton android:id="@+id/discovery_track_open" style="@style/Discovery.Button.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/discovery_open" android:layout_weight="1" android:layout_marginEnd="8dp" app:icon="@drawable/ic_discovery_external" app:iconGravity="textEnd"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/discovery_track_save" style="@style/Discovery.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/discovery_save" android:layout_weight="1" app:icon="@drawable/ic_favorite_empty" app:iconGravity="textStart"/>
  </LinearLayout>
  <com.google.android.material.button.MaterialButton android:id="@+id/discovery_track_details" style="@style/Discovery.Button.Text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/discovery_track_details" app:icon="@drawable/ic_discovery_expand" app:iconGravity="textEnd"/>
  <LinearLayout android:id="@+id/discovery_track_detail_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
   <TextView android:id="@+id/discovery_track_source" style="@style/Discovery.Copy" android:layout_width="match_parent" android:layout_height="wrap_content"  android:textIsSelectable="true"/>
   <TextView android:id="@+id/discovery_track_reason" style="@style/Discovery.Copy" android:layout_width="match_parent" android:layout_height="wrap_content"  android:paddingTop="12dp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/discovery_track_exclude" style="@style/Discovery.Button.Text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/discovery_exclude" />
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
