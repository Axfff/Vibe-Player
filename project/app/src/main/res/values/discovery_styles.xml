<resources>
 <style name="Discovery.Card" parent="Widget.MaterialComponents.CardView">
  <item name="cardCornerRadius">16dp</item><item name="cardElevation">0dp</item>
  <item name="cardBackgroundColor">?attr/main_bg</item><item name="strokeWidth">1dp</item><item name="strokeColor">?attr/colorControlHighlight</item>
 </style>
 <style name="Discovery.Copy" parent=""><item name="android:textSize">14sp</item><item name="android:textColor">?android:attr/textColorSecondary</item><item name="android:lineSpacingExtra">2dp</item></style>
 <style name="Discovery.Label" parent=""><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item><item name="android:textColor">?android:attr/textColorPrimary</item></style>
 <style name="Discovery.Heading" parent="Discovery.Label"><item name="android:textSize">28sp</item></style>
 <style name="Discovery.Button.Primary" parent="Widget.MaterialComponents.Button">
     <item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item>
     <item name="android:textSize">14sp</item><item name="cornerRadius">12dp</item><item name="iconSize">18dp</item>
    </style><style name="Discovery.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
     <item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item>
     <item name="android:textSize">14sp</item><item name="cornerRadius">12dp</item><item name="iconSize">18dp</item>
    </style><style name="Discovery.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
     <item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item>
     <item name="android:textSize">14sp</item><item name="cornerRadius">12dp</item><item name="iconSize">18dp</item>
    </style>
</resources>
